# AI runtime: local-first with Ollama. No commercial API key is required.
# Pull a model first: ollama pull qwen2.5:7b
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

# Optional commercial provider. Set OPENAI_API_KEY to show OpenAI beside local Ollama.
# Configure model IDs explicitly; model names are never guessed from the vendor.
# OPENAI_API_KEY=
# OPENAI_MODELS=gpt-4o-mini,gpt-4.1-mini
#
# Optional generic OpenAI-compatible provider (for example, another hosted API).
# AI_COMPATIBLE_API_URL=https://your-provider.example/v1
# AI_COMPATIBLE_API_KEY=
# AI_COMPATIBLE_MODELS=your-model-id
#
# Backward-compatible single-provider configuration:
# AI_PROVIDER=openai
# AI_API_URL=https://api.openai.com/v1
# AI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
#
# Optional comma-separated list to restrict the local Ollama models displayed.
# OLLAMA_MODELS=qwen2.5:7b,llama3.1:8b,mistral:7b

# MCP endpoint. Set a long random key before exposing it beyond localhost.
MCP_ENABLED=true
MCP_API_KEY=
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0

# Required for Google sign-in and the PostgreSQL-backed admin settings UI.
# Create Google OAuth credentials with http://localhost:3000/api/auth/callback/google
# (and your production URL) as authorized redirect URIs.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: openssl rand -base64 32
AUTH_TRUST_HOST=true
DATABASE_URL=postgresql://canvasium:canvasium@localhost:5432/canvasium
# Comma-separated emails allowed to access /admin.
ADMIN_EMAILS=
# Required in production to let the authenticated Next.js proxy call Fastify.
INTERNAL_API_SECRET=
# Optional production error monitoring.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional. Used only by the legacy Vite prototype.
# Any OpenAI-compatible chat-completions endpoint works.
AI_API_URL=

# Legacy prototype server settings (defaults shown)
# PORT=5173
# HOST=127.0.0.1
# DATA_FILE=data/canvasium.json
