# Optional. Used by the new Fastify planner (Vercel AI SDK + OpenAI).
# Without a key, it uses the local deterministic starter planner.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0

# Required for Google sign-in and the PostgreSQL-backed admin settings UI.
# Create Google OAuth credentials with http://localhost:3000/api/auth/callback/google
# (and your production URL) as authorized redirect URIs.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: openssl rand -base64 32
AUTH_TRUST_HOST=true
DATABASE_URL=postgresql://canvasium:canvasium@localhost:5432/canvasium
# Comma-separated emails allowed to access /admin.
ADMIN_EMAILS=
# Required in production to let the authenticated Next.js proxy call Fastify.
INTERNAL_API_SECRET=
# Optional production error monitoring.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional. Used only by the legacy Vite prototype.
# Any OpenAI-compatible chat-completions endpoint works.
AI_API_URL=

# Legacy prototype server settings (defaults shown)
# PORT=5173
# HOST=127.0.0.1
# DATA_FILE=data/canvasium.json
