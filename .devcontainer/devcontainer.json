{
  "name": "The Canvasium",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "postCreateCommand": "npm install --global pnpm@10.12.1 && pnpm install",
  "forwardPorts": [3000, 3001, 5173],
  "portsAttributes": {
    "3000": {
      "label": "The Canvasium workspace",
      "onAutoForward": "openBrowser"
    },
    "3001": {
      "label": "The Canvasium API"
    },
    "5173": {
      "label": "The Canvasium demo",
      "onAutoForward": "openBrowser"
    }
  }
}
