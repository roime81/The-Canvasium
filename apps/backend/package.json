{
  "name": "@canvasium/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@canvasium/types": "workspace:*",
    "@ai-sdk/openai": "^3.0.134",
    "ai": "^6.0.317",
    "dotenv": "^16.5.0",
    "fastify": "^5.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "@types/node": "^22.15.30",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
