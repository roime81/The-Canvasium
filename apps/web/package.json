{
  "name": "@canvasium/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "prepare:prisma": "prisma generate",
    "prepare:duckdb": "node scripts/copy-duckdb-assets.mjs",
    "dev": "pnpm prepare:prisma && pnpm prepare:duckdb && next dev --hostname 0.0.0.0",
    "build": "pnpm prepare:prisma && pnpm prepare:duckdb && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@canvasium/types": "workspace:*",
    "@prisma/client": "^6.7.0",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^1.5.2",
    "react-resizable": "^3.0.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-grid-layout": "^1.3.5",
    "prisma": "^6.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
